{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krafen",
  "main": "worker.js",
  "compatibility_date": "2026-04-28",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "WATCHLIST",
      "id": "207bb13567634f9f95412d1a6f0fc7d4"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "ADMIN_PASSWORD",
      "store_id": "dbaa438c8dd84df6b699fe1de942e717",
      "secret_name": "ADMIN_PASSWORD"
    },
    {
      "binding": "TMDB_ACCESS_TOKEN",
      "store_id": "dbaa438c8dd84df6b699fe1de942e717",
      "secret_name": "TMDB_ACCESS_TOKEN"
    },
    {
      "binding": "TWITCH_CLIENT_ID",
      "store_id": "dbaa438c8dd84df6b699fe1de942e717",
      "secret_name": "TWITCH_CLIENT_ID"
    },
    {
      "binding": "TWITCH_CLIENT_SECRET",
      "store_id": "dbaa438c8dd84df6b699fe1de942e717",
      "secret_name": "TWITCH_CLIENT_SECRET"
    }
  ]
}
