{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krafen",
  "main": "worker.js",
  "compatibility_date": "2026-04-28",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "WATCHLIST",
      "id": "8edcbef9e12143629b7274fbddfdc726"
    }
  ],
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 8,
        "period": 300
      }
    },
    {
      "name": "WRITE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "GAME_SEARCH_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 45,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_API_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "ADMIN_PASSWORD",
      "store_id": "dbaa438c8dd84df6b699fe1de942e717",
      "secret_name": "ADMIN_PASSWORD"
    },
    {
      "binding": "TMDB_ACCESS_TOKEN",
      "store_id": "dbaa438c8dd84df6b699fe1de942e717",
      "secret_name": "TMDB_ACCESS_TOKEN"
    },
    {
      "binding": "TWITCH_CLIENT_ID",
      "store_id": "dbaa438c8dd84df6b699fe1de942e717",
      "secret_name": "TWITCH_CLIENT_ID"
    },
    {
      "binding": "TWITCH_CLIENT_SECRET",
      "store_id": "dbaa438c8dd84df6b699fe1de942e717",
      "secret_name": "TWITCH_CLIENT_SECRET"
    }
  ]
}
